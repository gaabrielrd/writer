rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function validStudioDate(value) {
      return value is number && value >= 0 && value <= 8640000000000000;
    }

    function preserveBookDates() {
      return (!validStudioDate(resource.data.get('updatedAt', null))
          || validStudioDate(request.resource.data.get('updatedAt', null)))
        && (!validStudioDate(resource.data.get('createdAt', null))
          || validStudioDate(request.resource.data.get('createdAt', null)));
    }

    function isBookAuthor(bookId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/books/$(bookId)).data.authorId == request.auth.uid;
    }

    function boundedSceneList() {
      return request.query.limit != null && request.query.limit > 0 && request.query.limit <= 50;
    }
    function sceneBookReadable(bookId) {
      return isBookAuthor(bookId)
        && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) != true;
    }
    function sceneAdventureReadable(adventureId) {
      return isOwner(get(/databases/$(database)/documents/adventures/$(adventureId)).data.ownerId)
        && get(/databases/$(database)/documents/adventures/$(adventureId)).data.get('deleting', false) != true;
    }
    function publicationSceneMatches(bookId, data) {
      let book = get(/databases/$(database)/documents/books/$(bookId)).data;
      return book.get('hasSceneResources', false) != true
        || (data.get('sourceSceneRevision', -1) is int
          && data.get('sourceSceneRevision', -1) == book.get('sceneRevision', 0));
    }

    function isPublished(bookId) {
      return get(/databases/$(database)/documents/books/$(bookId)).data.status == 'published';
    }

    function isCurrentRevision(bookId, revisionId) {
      return exists(/databases/$(database)/documents/publicBooks/$(bookId))
        && get(/databases/$(database)/documents/publicBooks/$(bookId)).data.revisionId == revisionId;
    }

    function canReadRevision(bookId, revisionId) {
      return isBookAuthor(bookId) || (isPublished(bookId) && isCurrentRevision(bookId, revisionId)
        && universePublicationCurrent(get(/databases/$(database)/documents/publicBooks/$(bookId)).data));
    }

    function universePublicationCurrent(data) {
      let universeId = data.get('universeId', null);
      return universeId == null || (universeId is string
        && exists(/databases/$(database)/documents/publicUniversePrivacy/$(universeId))
        && get(/databases/$(database)/documents/publicUniversePrivacy/$(universeId)).data.active == true
        && get(/databases/$(database)/documents/publicUniversePrivacy/$(universeId)).data.version == data.get('universePrivacyVersion', -1));
    }

    function publicationUniverseMatches(bookId, data) {
      let universeId = get(/databases/$(database)/documents/books/$(bookId)).data.get('universeId', null);
      return data.get('universeId', null) == universeId
        && (universeId == null || (universePublicationCurrent(data)
          && get(/databases/$(database)/documents/universes/$(universeId)).data.authorId == request.auth.uid
          && get(/databases/$(database)/documents/universes/$(universeId)).data.get('deleting', false) == false));
    }

    function nonemptyString(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function validPublicBook(data) {
      return data.keys().hasAll(['schemaVersion', 'title', 'authorName', 'revisionId', 'publishedAt'])
        && data.keys().hasOnly(['schemaVersion', 'title', 'authorName', 'revisionId', 'publishedAt', 'universeId', 'universePrivacyVersion', 'hasActs', 'sourceSceneRevision'])
        && data.get('sourceSceneRevision', 0) is int && data.get('sourceSceneRevision', 0) >= 0
        && ((data.schemaVersion == 1 && data.get('universeId', null) == null && data.get('universePrivacyVersion', null) == null) || (data.schemaVersion == 2
          && nonemptyString(data.get('universeId', ''), 128)
          && data.get('universePrivacyVersion', -1) is int && data.universePrivacyVersion >= 0))
        && data.get('hasActs', false) is bool
        && nonemptyString(data.title, 300)
        && nonemptyString(data.authorName, 120)
        && nonemptyString(data.revisionId, 128)
        && data.publishedAt is int && data.publishedAt >= 0;
    }

    function validRevision(data) {
      return data.keys().hasAll(['createdAt', 'chapterCount', 'loreCount', 'privacyVersion'])
        && data.keys().hasOnly(['createdAt', 'chapterCount', 'loreCount', 'privacyVersion', 'universeId', 'universePrivacyVersion', 'actCount', 'sourceSceneRevision'])
        && data.get('sourceSceneRevision', 0) is int && data.get('sourceSceneRevision', 0) >= 0
        && data.privacyVersion is int && data.privacyVersion >= 0
        && data.createdAt is int && data.createdAt >= 0
        && data.chapterCount is int && data.chapterCount >= 0
        && data.loreCount is int && data.loreCount >= 0
        && data.get('actCount', 0) is int && data.get('actCount', 0) >= 0;
    }

    function validChapter(data) {
      return data.keys().hasAll(['title', 'order', 'content'])
        && data.keys().hasOnly(['title', 'order', 'content', 'actId'])
        && nonemptyString(data.title, 300)
        && data.order is int && data.order >= 0
        && data.content is string && data.content.size() <= 900000
        && (data.get('actId', null) == null || nonemptyString(data.actId, 128));
    }

    function validAct(data) {
      return data.keys().hasAll(['name', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'order', 'createdAt', 'updatedAt'])
        && (data.name == null || nonemptyString(data.name, 300))
        && data.order is int && data.order > 0 && data.order <= 3999
        && data.createdAt is int && data.createdAt >= 0
        && data.updatedAt is int && data.updatedAt >= data.createdAt;
    }
    function validActLink(bookId, data) {
      let actId = data.get('actId', null);
      return actId == null || (nonemptyString(actId, 128)
        && exists(/databases/$(database)/documents/books/$(bookId)/acts/$(actId)));
    }
    function validPublicAct(data) {
      return data.keys().hasAll(['name', 'order'])
        && data.keys().hasOnly(['name', 'order'])
        && nonemptyString(data.name, 300)
        && data.order is int && data.order > 0 && data.order <= 3999;
    }

    function validAlias(aliases, index) {
      return aliases.size() <= index || (aliases[index] is string && aliases[index].size() <= 200);
    }

    function validBookLocalLoreVersion(value) {
      return value is int && value >= 0 && value <= 9007199254740991;
    }

    function preserveBookLocalLoreVersion() {
      let previous = resource.data.get('localLoreVersion', 0);
      let next = request.resource.data.get('localLoreVersion', 0);
      return validBookLocalLoreVersion(previous) && validBookLocalLoreVersion(next)
        && (!resource.data.keys().hasAny(['localLoreVersion'])
          || request.resource.data.keys().hasAll(['localLoreVersion']))
        && (next == previous || (previous < 9007199254740991 && next == previous + 1));
    }

    function preserveWorkHistoryRevision() {
      let before = resource.data.get('historyRevision', 0);
      let after = request.resource.data.get('historyRevision', 0);
      return before is int && before >= 0 && before <= 9007199254740991
        && after is int && after == before
        && (!resource.data.keys().hasAny(['historyRevision'])
          || request.resource.data.keys().hasAll(['historyRevision']));
    }

    function bookLocalLoreAdvanced(bookId) {
      let before = get(/databases/$(database)/documents/books/$(bookId)).data;
      let after = getAfter(/databases/$(database)/documents/books/$(bookId)).data;
      let previous = before.get('localLoreVersion', 0);
      let next = after.get('localLoreVersion', null);
      return validBookLocalLoreVersion(previous) && validBookLocalLoreVersion(next)
        && previous < 9007199254740991 && next == previous + 1;
    }

    function validLore(data) {
      return data.keys().hasAll(['name', 'aliases', 'category', 'summary'])
        && data.keys().hasOnly(['name', 'aliases', 'category', 'summary', 'sourceEntityId'])
        && (data.get('sourceEntityId', null) == null || nonemptyString(data.sourceEntityId, 128))
        && nonemptyString(data.name, 200)
        && data.aliases is list && data.aliases.size() <= 20
        && validAlias(data.aliases, 0) && validAlias(data.aliases, 1)
        && validAlias(data.aliases, 2) && validAlias(data.aliases, 3)
        && validAlias(data.aliases, 4) && validAlias(data.aliases, 5)
        && validAlias(data.aliases, 6) && validAlias(data.aliases, 7)
        && validAlias(data.aliases, 8) && validAlias(data.aliases, 9)
        && validAlias(data.aliases, 10) && validAlias(data.aliases, 11)
        && validAlias(data.aliases, 12) && validAlias(data.aliases, 13)
        && validAlias(data.aliases, 14) && validAlias(data.aliases, 15)
        && validAlias(data.aliases, 16) && validAlias(data.aliases, 17)
        && validAlias(data.aliases, 18) && validAlias(data.aliases, 19)
        && data.category in ['character', 'location', 'concept', 'other']
        && data.summary is string && data.summary.size() <= 140;
    }

    function validNewUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoUrl', 'credits', 'tier', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'credits', 'tier', 'createdAt', 'updatedAt'])
        && data.uid == userId && data.tier == 'free' && data.credits is int && data.credits == 100
        && (data.email == null || data.email is string)
        && (data.displayName == null || data.displayName is string)
        && (data.photoUrl == null || data.photoUrl is string)
        && data.createdAt is int && data.updatedAt is int;
    }

    function validUserUpdate(data) {
      return data.credits is int && data.credits >= 0
        && data.tier == resource.data.tier
        && data.uid == resource.data.uid
        && data.createdAt == resource.data.createdAt
        && (data.email == null || data.email is string)
        && (data.displayName == null || data.displayName is string)
        && (data.photoUrl == null || data.photoUrl is string)
        && data.updatedAt is int;
    }

    function isMonthlyCreditGrant() {
      let previous = resource.data.get('creditsRenewedAt', null);
      return resource.data.tier == 'premium'
        && exists(/databases/$(database)/documents/creditEntitlements/$(request.auth.uid))
        && get(/databases/$(database)/documents/creditEntitlements/$(request.auth.uid)).data.tier == 'premium'
        && get(/databases/$(database)/documents/creditEntitlements/$(request.auth.uid)).data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'creditsRenewedAt', 'updatedAt'])
        && request.resource.data.credits == resource.data.credits + 2000
        && request.resource.data.creditsRenewedAt == request.time
        && (previous == null || (previous is timestamp
          && previous < timestamp.date(request.time.year(), request.time.month(), 1)));
    }

    // Provisioned only by a trusted administrator, never by the browser.
    match /creditEntitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    function validPublicationState(bookId) {
      let beforeVersion = resource.data.get('publicationPrivacyVersion', 0);
      let afterVersion = request.resource.data.get('publicationPrivacyVersion', 0);
      return beforeVersion is int && afterVersion is int
        && afterVersion >= beforeVersion && afterVersion <= beforeVersion + 1
        && (afterVersion == beforeVersion || (request.resource.data.status == 'draft'
          && !existsAfter(/databases/$(database)/documents/publicBooks/$(bookId))))
        && (resource.data.get('deleting', false) != true || request.resource.data.get('deleting', false) == true)
        && (request.resource.data.get('deleting', false) != true || (request.resource.data.status == 'draft'
          && !existsAfter(/databases/$(database)/documents/publicBooks/$(bookId))));
    }

    function validPersonaTraitAt(traits, index) {
      let trait = traits.size() > index ? traits[index] : null;
      return traits.size() <= index || (trait is map && trait.value is int && trait.value >= 0 && trait.value <= 100);
    }
    function validAIPersona(data, personaId) {
      return data.keys().hasOnly(['id', 'schemaVersion', 'name', 'description', 'instructions', 'traits', 'revision', 'archived', 'createdAt', 'updatedAt'])
        && data.id == personaId && personaId.matches('^custom-[a-zA-Z0-9-]{1,93}$')
        && data.schemaVersion == 1
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 500
        && data.instructions is string && data.instructions.size() > 0 && data.instructions.size() <= 6000
        && data.revision is int && data.revision >= 1
        && data.archived is bool && data.createdAt is int && data.updatedAt is int
        && data.traits is list && data.traits.size() >= 8 && data.traits.size() <= 16
        && validPersonaTraitAt(data.traits, 0)
        && validPersonaTraitAt(data.traits, 1)
        && validPersonaTraitAt(data.traits, 2)
        && validPersonaTraitAt(data.traits, 3)
        && validPersonaTraitAt(data.traits, 4)
        && validPersonaTraitAt(data.traits, 5)
        && validPersonaTraitAt(data.traits, 6)
        && validPersonaTraitAt(data.traits, 7)
        && validPersonaTraitAt(data.traits, 8)
        && validPersonaTraitAt(data.traits, 9)
        && validPersonaTraitAt(data.traits, 10)
        && validPersonaTraitAt(data.traits, 11)
        && validPersonaTraitAt(data.traits, 12)
        && validPersonaTraitAt(data.traits, 13)
        && validPersonaTraitAt(data.traits, 14)
        && validPersonaTraitAt(data.traits, 15);
    }
    function validPersonaReference(personaId) {
      return personaId == null || (personaId is string && (personaId in ['preset-atmospheric', 'preset-incisive', 'preset-intimate', 'preset-ironic', 'preset-epic', 'preset-unsettling']
        || (personaId.matches('^custom-[a-zA-Z0-9-]{1,93}$') && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/aiPersonas/$(personaId)))));
    }
    function validPersonaOverride(item) {
      return item.keys().hasOnly(['traitId', 'value'])
        && item.traitId.matches('^[a-zA-Z0-9-]{1,100}$')
        && item.value is int && item.value >= 0 && item.value <= 100;
    }
    function validPersonaComplement(data) {
      let overrides = data is map ? data.get('overrides', []) : [];
      let size = overrides is list ? overrides.size() : -1;
      return data == null ? true : (data is map && data.keys().hasOnly(['personaId', 'overrides'])
        && data.personaId != null && validPersonaReference(data.personaId)
        && data.keys().hasAll(['overrides']) && size >= 0 && size <= 16
        && (size <= 0 ? true : validPersonaOverride(overrides[0]))
        && (size <= 1 ? true : validPersonaOverride(overrides[1]))
        && (size <= 2 ? true : validPersonaOverride(overrides[2]))
        && (size <= 3 ? true : validPersonaOverride(overrides[3]))
        && (size <= 4 ? true : validPersonaOverride(overrides[4]))
        && (size <= 5 ? true : validPersonaOverride(overrides[5]))
        && (size <= 6 ? true : validPersonaOverride(overrides[6]))
        && (size <= 7 ? true : validPersonaOverride(overrides[7]))
        && (size <= 8 ? true : validPersonaOverride(overrides[8]))
        && (size <= 9 ? true : validPersonaOverride(overrides[9]))
        && (size <= 10 ? true : validPersonaOverride(overrides[10]))
        && (size <= 11 ? true : validPersonaOverride(overrides[11]))
        && (size <= 12 ? true : validPersonaOverride(overrides[12]))
        && (size <= 13 ? true : validPersonaOverride(overrides[13]))
        && (size <= 14 ? true : validPersonaOverride(overrides[14]))
        && (size <= 15 ? true : validPersonaOverride(overrides[15])));
    }
    match /adventureImportReservations/{id} { allow read, write: if false; }
    match /users/{userId} {
      match /adventureImports/{document=**} { allow read, write: if false; }
      match /adventureImportRecoveryKeys/{id} { allow read, write: if false; }
      match /adventureImportOperations/{id} { allow read, write: if false; }
      match /adventureImportStartFences/{id} { allow read, write: if false; }
      // Conversations, provider origin and debit receipts are server controlled.
      match /chapterChats/{document=**} { allow read, write: if false; }
      match /chapterChatLimits/{id} { allow read, write: if false; }
      match /editorChatContexts/{id} { allow read, write: if false; }
      match /editorChatContextBodies/{id} { allow read, write: if false; }
      match /editorChatOperations/{id} { allow read, write: if false; }
      match /editorChatCleanup/{id} { allow read, write: if false; }
      match /editorChats/{document=**} { allow read, write: if false; }
      match /editorChatCatalogs/{id} { allow read, write: if false; }
      match /aiPersonas/{personaId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validAIPersona(request.resource.data, personaId)
          && (request.method == 'create' ? request.resource.data.revision == 1
            : request.resource.data.revision == resource.data.revision + 1
              && request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if false;
      }

      match /assistedSessions/{sessionId} {
        allow read, write: if false;
        match /operations/{operationId} { allow read, write: if false; }
      }
      match /assistedCurrent/{id} { allow read, write: if false; }
      match /assistedLimits/{id} { allow read, write: if false; }
      match /assistedReceipts/{id} { allow read, write: if false; }
      match /studioOperations/{operationId} { allow read, write: if false; }
      match /studioPreparation/{preparationId} { allow read, write: if false; }
      // Campaign adoption and its authorization clock are server controlled.
      match /campaignAdoptions/{document=**} { allow read, write: if false; }
      match /campaignAdoptionOperations/{id} { allow read, write: if false; }
      match /campaignAdoptionStartFences/{id} { allow read, write: if false; }
      match /campaignAdoptionGuards/{id} { allow read, write: if false; }
      match /campaignVariantResolutionOperations/{id} { allow read, write: if false; }
      match /campaignAuthorization/{id} { allow read, write: if false; }
      match /campaignDeletions/{document=**} { allow read, write: if false; }
      match /campaignDeletionOperations/{id} { allow read, write: if false; }
      match /campaignDeletionStartFences/{id} { allow read, write: if false; }
      match /adventureLoreOperations/{id} { allow read, write: if false; }
      match /adventureLoreFences/{id} { allow read, write: if false; }
      match /campaignPreparationOperations/{id} { allow read, write: if false; }
      match /campaignPreparationFences/{id} { allow read, write: if false; }
      match /campaignSessionOperations/{id} { allow read, write: if false; }
      match /campaignSessionReferenceOperations/{id} { allow read, write: if false; }
      match /campaignSessionReferenceFences/{id} { allow read, write: if false; }
      match /sceneOperations/{operationId} { allow read, write: if false; }
      match /narrativeOperations/{operationId} { allow read, write: if false; }
      match /workOperations/{operationId} { allow read, write: if false; }
      match /workPreferences/{id} { allow read, write: if false; }
      match /workActivity/{id} { allow read, write: if false; }
      match /workActivityState/{id} { allow read, write: if false; }
      match /imageLibrary/{imageId} {
        allow read: if isOwner(userId);
        allow write: if false;
        match /uses/{bookId} { allow read, write: if false; }
      }
      match /imageLibraryMigration/{markerId} { allow read, write: if false; }
      match /bookGenerations/{generationId} {
        allow read, write: if false;
      }
      match /generationLimits/{limitId} {
        allow read, write: if false;
      }
      match /loreAnalyses/{analysisId} { allow read, write: if false; }
      match /loreAnalysisLimits/{limitId} { allow read, write: if false; }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validNewUser(request.resource.data, userId);
      allow update: if isOwner(userId) && validUserUpdate(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoUrl', 'email', 'updatedAt'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'updatedAt'])
          && request.resource.data.credits == resource.data.credits - 1)
        || isMonthlyCreditGrant()
      );
      // Prevent deleting and recreating a profile to mint the initial grant again.
      allow delete: if false;
    }

    // Irreversible IDs prevent a deleted book from reattaching orphaned snapshots.
    match /deletedBooks/{bookId} {
      allow read, update, delete: if false;
      allow create: if isBookAuthor(bookId)
        && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) == true
        && request.resource.data.keys().hasOnly(['deletedAt'])
        && request.resource.data.deletedAt == request.time;
    }

    // Originals are always private, including published books and public lore.
    match /universes/{universeId} {
      allow read: if isOwner(resource.data.authorId);
      allow write: if false;
      match /lore/{entityId} {
        allow read: if isOwner(get(/databases/$(database)/documents/universes/$(universeId)).data.authorId)
          && get(/databases/$(database)/documents/universes/$(universeId)).data.get('deleting', false) == false;
        allow write: if false;
      }
      match /books/{bookId} { allow read, write: if false; }
      match /adventures/{adventureId} { allow read, write: if false; }
      match /campaigns/{campaignId} { allow read, write: if false; }
    }

    match /adventures/{adventureId} {
      match /lore/{document=**} { allow read, write: if false; }
      match /loreBodies/{document=**} { allow read, write: if false; }
      match /sceneBlocks/{blockId} {
        allow read, write: if false;
        match /{child}/{id} { allow read, write: if false; }
      }
      match /workVersions/{id} { allow read, write: if false; }
      match /workVersionBodies/{id} { allow read, write: if false; }
      allow get: if isOwner(resource.data.ownerId);
      allow list: if isOwner(resource.data.ownerId)
        && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 50;
      allow write: if false;
      match /parts/{partId} {
        allow get: if sceneAdventureReadable(adventureId);
        allow list: if sceneAdventureReadable(adventureId) && boundedSceneList();
        allow write: if false;
      }
      match /scenes/{sceneId} {
        allow get: if sceneAdventureReadable(adventureId);
        allow list: if sceneAdventureReadable(adventureId) && boundedSceneList();
        allow write: if false;
        match /{child}/{childId} {
          allow get: if child in ['body', 'planning', 'references'] && sceneAdventureReadable(adventureId);
          allow list: if child == 'references' && sceneAdventureReadable(adventureId) && boundedSceneList();
          allow write: if false;
        }
      }
      match /sceneControls/{id} { allow read, write: if false; }
      match /sceneJobs/{id} { allow read, write: if false; }
      match /arcs/{arcId} {
        allow get: if sceneAdventureReadable(adventureId);
        allow list: if sceneAdventureReadable(adventureId) && boundedSceneList();
        allow write: if false;
        match /milestones/{id} {
          allow get: if sceneAdventureReadable(adventureId)
            && get(/databases/$(database)/documents/adventures/$(adventureId)/arcs/$(arcId)).data.get('deleting', false) != true;
          allow list: if sceneAdventureReadable(adventureId) && boundedSceneList()
            && get(/databases/$(database)/documents/adventures/$(adventureId)/arcs/$(arcId)).data.get('deleting', false) != true;
          allow write: if false;
        }
      }
      match /timelineEvents/{id} {
        allow get: if sceneAdventureReadable(adventureId);
        allow list: if sceneAdventureReadable(adventureId) && boundedSceneList();
        allow write: if false;
      }
      match /narrativeLinks/{id} {
        allow get: if sceneAdventureReadable(adventureId);
        allow list: if sceneAdventureReadable(adventureId) && boundedSceneList();
        allow write: if false;
      }
      match /{privateCollection}/{id} {
        allow read, write: if false;
      }
    }

    match /campaignDeletionReservations/{campaignId} { allow read, write: if false; }

    match /campaigns/{campaignId} {
      match /preparationItems/{document=**} { allow read, write: if false; }
      match /preparationBodies/{document=**} { allow read, write: if false; }
      match /preparationState/{document=**} { allow read, write: if false; }
      match /sessionPreparationLinks/{document=**} { allow read, write: if false; }
      match /sessionPreparationState/{document=**} { allow read, write: if false; }
      match /loreGenerations/{document=**} { allow read, write: if false; }
      match /sessions/{document=**} { allow read, write: if false; }
      match /sessionState/{document=**} { allow read, write: if false; }
      match /sessionReferences/{document=**} { allow read, write: if false; }
      match /sessionReferenceState/{document=**} { allow read, write: if false; }
      allow read, write: if false;
    }

    // Minimal public revocation signal, never names, descriptions or author identity.
    match /publicUniversePrivacy/{universeId} {
      allow get: if true;
      allow list, write: if false;
    }

    match /books/{bookId} {
      match /workVersions/{id} { allow read, write: if false; }
      match /workVersionBodies/{id} { allow read, write: if false; }
      // Allow an authenticated creator to read an absent ID before the atomic create.
      // Existing manuscripts remain restricted to their author.
      allow get: if isAuthenticated()
        && !exists(/databases/$(database)/documents/books/$(bookId));
      allow read: if isOwner(resource.data.authorId);
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && validBookLocalLoreVersion(request.resource.data.get('localLoreVersion', null))
        && request.resource.data.localLoreVersion == 0
        && request.resource.data.get('hasSceneResources', false) == false
        && request.resource.data.get('sceneRevision', 0) == 0
        && request.resource.data.get('historyRevision', 0) is int
        && request.resource.data.get('historyRevision', 0) == 0
        && request.resource.data.get('hasNarrativeResources', false) == false
        && request.resource.data.get('narrativeRevision', 0) == 0
        && request.resource.data.get('hasProgressResources', false) == false
        && request.resource.data.get('editorialState', null) == null
        && request.resource.data.get('sceneDeletionOperationId', null) == null
        && validStudioDate(request.resource.data.get('createdAt', null))
        && validStudioDate(request.resource.data.get('updatedAt', null))
        && request.resource.data.get('universeId', null) == null
        && request.resource.data.status == 'draft'
        && validPersonaReference(request.resource.data.get('personaId', null))
        && request.resource.data.get('coverImageId', null) == null
        && request.resource.data.get('publicationPrivacyVersion', 0) == 0
        && request.resource.data.get('deleting', false) == false
        && !exists(/databases/$(database)/documents/deletedBooks/$(bookId));
      allow update: if isOwner(resource.data.authorId)
        && preserveBookDates()
        && preserveBookLocalLoreVersion()
        && preserveWorkHistoryRevision()
        && request.resource.data.get('hasSceneResources', false) == resource.data.get('hasSceneResources', false)
        && request.resource.data.get('sceneRevision', 0) == resource.data.get('sceneRevision', 0)
        && request.resource.data.get('hasNarrativeResources', false) == resource.data.get('hasNarrativeResources', false)
        && request.resource.data.get('narrativeRevision', 0) == resource.data.get('narrativeRevision', 0)
        && request.resource.data.get('hasProgressResources', false) == resource.data.get('hasProgressResources', false)
        && request.resource.data.get('editorialState', null) == resource.data.get('editorialState', null)
        && (resource.data.get('hasProgressResources', false) != true
          || request.resource.data.get('wordCount', 0) == resource.data.get('wordCount', 0))
        && request.resource.data.get('sceneDeletionOperationId', null) == resource.data.get('sceneDeletionOperationId', null)
        && validPersonaReference(request.resource.data.get('personaId', null))
        && request.resource.data.get('universeId', null) == resource.data.get('universeId', null)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.get('coverImageId', null) == resource.data.get('coverImageId', null)
        && (resource.data.get('coverImageId', null) == null || request.resource.data.get('coverUrl', null) == resource.data.get('coverUrl', null))
        && validPublicationState(bookId)
        && request.resource.data.status in ['draft', 'published']
        && (request.resource.data.status == 'draft'
          || resource.data.status == 'published'
          || existsAfter(/databases/$(database)/documents/publicBooks/$(bookId)));
      allow delete: if isOwner(resource.data.authorId)
        && resource.data.get('hasSceneResources', false) != true
        && resource.data.get('hasNarrativeResources', false) != true
        && resource.data.get('hasProgressResources', false) != true
        && resource.data.get('deleting', false) == true
        && existsAfter(/databases/$(database)/documents/deletedBooks/$(bookId))
        && !existsAfter(/databases/$(database)/documents/publicBooks/$(bookId));

      match /acts/{actId} {
        allow read: if isBookAuthor(bookId);
        allow create: if isBookAuthor(bookId) && validAct(request.resource.data)
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) == false
          && getAfter(/databases/$(database)/documents/books/$(bookId)).data.get('actCount', 0) == request.resource.data.order;
        allow update: if false;
        allow delete: if isBookAuthor(bookId)
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) == true;
      }
      match /chapters/{chapterId} {
        allow read: if isBookAuthor(bookId);
        allow delete: if isBookAuthor(bookId)
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('hasProgressResources', false) != true
          && resource.data.get('contentMode', 'legacy') != 'scenes'
          && resource.data.get('deleting', false) != true;
        allow create: if isBookAuthor(bookId)
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('hasProgressResources', false) != true
          && request.resource.data.get('contentMode', 'legacy') == 'legacy'
          && validActLink(bookId, request.resource.data)
          && validPersonaComplement(request.resource.data.get('personaComplement', null))
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) != true;
        allow update: if isBookAuthor(bookId)
          && resource.data.get('deleting', false) != true
          && (get(/databases/$(database)/documents/books/$(bookId)).data.get('hasProgressResources', false) != true
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'actId', 'order', 'personaComplement', 'updatedAt']))
          && (resource.data.get('contentMode', 'legacy') == 'legacy'
            ? request.resource.data.get('contentMode', 'legacy') == 'legacy'
            : (resource.data.get('contentMode', 'legacy') == 'scenes'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'actId', 'order', 'personaComplement', 'updatedAt'])))
          && validActLink(bookId, request.resource.data)
          && validPersonaComplement(request.resource.data.get('personaComplement', null))
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) != true;
      }

      match /scenes/{sceneId} {
        allow get: if sceneBookReadable(bookId);
        allow list: if sceneBookReadable(bookId) && boundedSceneList();
        allow write: if false;
        match /{child}/{childId} {
          allow get: if child in ['body', 'planning', 'references'] && sceneBookReadable(bookId);
          allow list: if child == 'references' && sceneBookReadable(bookId) && boundedSceneList();
          allow write: if false;
        }
      }
      match /sceneControls/{id} { allow read, write: if false; }
      match /sceneJobs/{id} { allow read, write: if false; }
      match /sceneSources/{id} { allow read, write: if false; }
      match /arcs/{arcId} {
        allow get: if sceneBookReadable(bookId);
        allow list: if sceneBookReadable(bookId) && boundedSceneList();
        allow write: if false;
        match /milestones/{id} {
          allow get: if sceneBookReadable(bookId)
            && get(/databases/$(database)/documents/books/$(bookId)/arcs/$(arcId)).data.get('deleting', false) != true;
          allow list: if sceneBookReadable(bookId) && boundedSceneList()
            && get(/databases/$(database)/documents/books/$(bookId)/arcs/$(arcId)).data.get('deleting', false) != true;
          allow write: if false;
        }
      }
      match /timelineEvents/{id} {
        allow get: if sceneBookReadable(bookId);
        allow list: if sceneBookReadable(bookId) && boundedSceneList();
        allow write: if false;
      }
      match /narrativeLinks/{id} {
        allow get: if sceneBookReadable(bookId);
        allow list: if sceneBookReadable(bookId) && boundedSceneList();
        allow write: if false;
      }
      match /narrativeControls/{id} { allow read, write: if false; }
      match /narrativeJobs/{id} { allow read, write: if false; }
      match /sceneLoreLinks/{id} { allow read, write: if false; }
      match /workProgress/{id} { allow read, write: if false; }
      match /workWordSources/{id} { allow read, write: if false; }
      match /workWordGroups/{id} { allow read, write: if false; }
      match /workChecklist/{id} { allow read, write: if false; }

      match /lore/{loreId} {
        function publicationRevoked() {
          return getAfter(/databases/$(database)/documents/books/$(bookId)).data.status == 'draft'
            && !existsAfter(/databases/$(database)/documents/publicBooks/$(bookId))
            && (getAfter(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) == true
              || getAfter(/databases/$(database)/documents/books/$(bookId)).data.get('publicationPrivacyVersion', 0)
                == get(/databases/$(database)/documents/books/$(bookId)).data.get('publicationPrivacyVersion', 0) + 1);
        }
        allow read: if isBookAuthor(bookId);
        allow create: if isBookAuthor(bookId)
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) != true
          && bookLocalLoreAdvanced(bookId);
        allow update: if isBookAuthor(bookId)
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) != true
          && bookLocalLoreAdvanced(bookId)
          && (resource.data.get('isPublic', false) != true
            || request.resource.data.get('isPublic', false) == true
            || publicationRevoked());
        allow delete: if isBookAuthor(bookId)
          && (get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) == true
            || bookLocalLoreAdvanced(bookId))
          && (resource.data.get('isPublic', false) != true || publicationRevoked());
      }
    }

    match /publicBooks/{bookId} {
      allow get: if isBookAuthor(bookId) || (isPublished(bookId)
        && (!exists(/databases/$(database)/documents/publicBooks/$(bookId)) || universePublicationCurrent(resource.data)));
      allow list: if false;
      allow create, update: if isBookAuthor(bookId)
        && validPublicBook(request.resource.data)
        && publicationSceneMatches(bookId, request.resource.data)
        && publicationUniverseMatches(bookId, request.resource.data)
        && getAfter(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) != true
        && getAfter(/databases/$(database)/documents/books/$(bookId)).data.status == 'published'
        && existsAfter(/databases/$(database)/documents/publicBooks/$(bookId)/revisions/$(request.resource.data.revisionId))
        && getAfter(/databases/$(database)/documents/publicBooks/$(bookId)/revisions/$(request.resource.data.revisionId)).data.privacyVersion
          == getAfter(/databases/$(database)/documents/books/$(bookId)).data.get('publicationPrivacyVersion', 0)
        && getAfter(/databases/$(database)/documents/publicBooks/$(bookId)/revisions/$(request.resource.data.revisionId)).data.get('universeId', null) == request.resource.data.get('universeId', null)
        && getAfter(/databases/$(database)/documents/publicBooks/$(bookId)/revisions/$(request.resource.data.revisionId)).data.get('universePrivacyVersion', null) == request.resource.data.get('universePrivacyVersion', null)
        && getAfter(/databases/$(database)/documents/publicBooks/$(bookId)/revisions/$(request.resource.data.revisionId)).data.get('sourceSceneRevision', null) == request.resource.data.get('sourceSceneRevision', null);
      allow delete: if isBookAuthor(bookId)
        && getAfter(/databases/$(database)/documents/books/$(bookId)).data.status == 'draft';

      match /revisions/{revisionId} {
        allow get: if canReadRevision(bookId, revisionId);
        allow list: if isBookAuthor(bookId);
        allow create: if isBookAuthor(bookId) && !isCurrentRevision(bookId, revisionId)
          && validRevision(request.resource.data)
          && publicationSceneMatches(bookId, request.resource.data)
          && publicationUniverseMatches(bookId, request.resource.data)
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) != true
          && request.resource.data.privacyVersion == get(/databases/$(database)/documents/books/$(bookId)).data.get('publicationPrivacyVersion', 0);
        allow update: if false;
        allow delete: if isBookAuthor(bookId) && !isCurrentRevision(bookId, revisionId)
          && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) == true;

        match /acts/{actId} {
          allow read: if canReadRevision(bookId, revisionId);
          allow create: if isBookAuthor(bookId) && !isCurrentRevision(bookId, revisionId)
            && validPublicAct(request.resource.data)
            && exists(/databases/$(database)/documents/books/$(bookId)/acts/$(actId))
            && get(/databases/$(database)/documents/books/$(bookId)/acts/$(actId)).data.order == request.resource.data.order
            && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) == false;
          allow update: if false;
          allow delete: if isBookAuthor(bookId) && !isCurrentRevision(bookId, revisionId);
        }

        match /chapters/{chapterId} {
          allow read: if canReadRevision(bookId, revisionId);
          allow create: if isBookAuthor(bookId) && !isCurrentRevision(bookId, revisionId)
            && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) != true
            && existsAfter(/databases/$(database)/documents/publicBooks/$(bookId)/revisions/$(revisionId))
            && validChapter(request.resource.data)
            && (request.resource.data.get('actId', null) == null
              || existsAfter(/databases/$(database)/documents/publicBooks/$(bookId)/revisions/$(revisionId)/acts/$(request.resource.data.actId)));
          allow update: if false;
          allow delete: if isBookAuthor(bookId) && !isCurrentRevision(bookId, revisionId);
        }

        match /lore/{loreId} {
          function originalConsent() {
            let sourceId = request.resource.data.get('sourceEntityId', null);
            let universeId = getAfter(/databases/$(database)/documents/publicBooks/$(bookId)/revisions/$(revisionId)).data.get('universeId', null);
            return sourceId == null
              ? get(/databases/$(database)/documents/books/$(bookId)/lore/$(loreId)).data.isPublic == true
              : (universeId != null
                && loreId == 'universe:' + universeId + ':' + sourceId
                && get(/databases/$(database)/documents/universes/$(universeId)/lore/$(sourceId)).data.isPublic == true);
          }
          allow read: if canReadRevision(bookId, revisionId);
          allow create: if isBookAuthor(bookId) && !isCurrentRevision(bookId, revisionId)
            && get(/databases/$(database)/documents/books/$(bookId)).data.get('deleting', false) != true
            && existsAfter(/databases/$(database)/documents/publicBooks/$(bookId)/revisions/$(revisionId))
            && originalConsent()
            && validLore(request.resource.data);
          allow update: if false;
          allow delete: if isBookAuthor(bookId) && !isCurrentRevision(bookId, revisionId);
        }
      }
    }
  }
}
