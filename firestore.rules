rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBookAuthor(bookId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/books/$(bookId)).data.authorId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /books/{bookId} {
      allow read: if resource.data.status == 'published' || isOwner(resource.data.authorId);
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.authorId);

      match /chapters/{chapterId} {
        allow read: if get(/databases/$(database)/documents/books/$(bookId)).data.status == 'published'
          || isBookAuthor(bookId);
        allow create, update, delete: if isBookAuthor(bookId);
      }

      match /lore/{loreId} {
        allow read: if resource.data.isPublic == true || isBookAuthor(bookId);
        allow create, update, delete: if isBookAuthor(bookId);
      }
    }
  }
}
